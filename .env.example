# At least one chat provider key is required. OpenRouter's free router
# (openrouter/free) is the default. Groq, Gemini, and ChatGPT are optional
# fallbacks.
OPENROUTER_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional model overrides. Leave unset to use OpenRouter's free-model router.
# OPENROUTER_MODEL=openrouter/free
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_MODEL=gemini-2.5-flash
# OPENAI_MODEL=gpt-4.1-mini

# Optional per-provider budgets (requests per minute / per day).
# OPENROUTER_RPM=16
# OPENROUTER_RPD=200
# GROQ_RPM=28
# GROQ_RPD=12000
# GEMINI_RPM=8
# GEMINI_RPD=200
# OPENAI_RPM=3
# OPENAI_RPD=200

# Contact form (Resend).
RESEND_API_KEY=

# Optional. Raises the GitHub API limit for the live contribution count.
# GITHUB_TOKEN=
